# --- Application ---
NODE_ENV=development
PORT=4000

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/smart-waste

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=smart-waste-backend
KAFKA_GROUP_ID=telemetry-processor
KAFKA_TELEMETRY_TOPIC=smart-waste.telemetry
KAFKA_CONNECTION_TIMEOUT_MS=3000
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_RETRY_INITIAL_RETRY_TIME_MS=300
KAFKA_RETRY_RETRIES=8
KAFKA_CONSUMER_SESSION_TIMEOUT_MS=30000

# --- Time-series DB ---
TIMESERIES_DB_URL=http://localhost:8086
TIMESERIES_DB_NAME=smart_waste_telemetry
TIMESERIES_DB_USER=
TIMESERIES_DB_PASSWORD=
TIMESERIES_DB_TIMEOUT=5000

# --- External AI Service ---
# NOTE: the real API contract (exact endpoint path, auth scheme,
# request/response shape) has not been confirmed yet. These values
# and the mapping in src/modules/ai/ai.service.js are placeholders —
# update AI_SERVICE_PREDICT_PATH/AI_SERVICE_API_KEY and the two
# mapping functions in ai.service.js once it is; nothing else in the
# app needs to change.
AI_SERVICE_URL=http://localhost:5001
AI_SERVICE_TIMEOUT=5000
AI_SERVICE_PREDICT_PATH=/api/v1/predict
AI_SERVICE_API_KEY=
AI_SERVICE_MAX_RETRIES=2
AI_SERVICE_RETRY_DELAY_MS=200

# --- External Route Service ---
# NOTE: the real API contract (exact endpoint path, auth scheme,
# request/response shape) was not provided. The assumed contract and
# the mapping in src/modules/route/route.service.js are placeholders
# — see the header comment in src/modules/route/route.client.js.
# Update ROUTE_GENERATE_PATH there and the two mapping functions in
# route.service.js once the real contract is confirmed; no other
# module needs to change.
ROUTE_SERVICE_URL=http://localhost:5002
ROUTE_SERVICE_TIMEOUT=5000

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Mock IoT simulator (mock-iot/simulator.js) ---
# Optional — read directly by the standalone simulator script, not by
# the backend (it's a dev-only client, not part of the app's own
# config/env.js schema). Defaults shown below.
# MOCK_IOT_TARGET_URL=http://localhost:4000/api/v1/telemetry
# MOCK_IOT_INTERVAL_MS=5000
